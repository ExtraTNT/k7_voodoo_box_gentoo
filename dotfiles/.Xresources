! urxvt — core Terminus font (no Xft), no scrollbar, amber cursor.
URxvt.font:            -xos4-terminus-medium-r-normal--16-*-*-*-*-*-iso10646-1
URxvt.boldFont:        -xos4-terminus-bold-r-normal--16-*-*-*-*-*-iso10646-1
URxvt.scrollBar:       false
URxvt.internalBorder:  6
URxvt.saveLines:       5000
URxvt.urgentOnBell:    true
URxvt.cursorBlink:     false
URxvt.cursorColor:     #d7a65f
URxvt.iso14755:        false

*.background:  #121212
*.foreground:  #bcbcbc
! black
*.color0:      #1c1c1c
*.color8:      #4e4e4e
! red
*.color1:      #af5f5f
*.color9:      #d78787
! green
*.color2:      #87875f
*.color10:     #afaf87
! yellow / amber
*.color3:      #d7a65f
*.color11:     #ffcf87
! blue
*.color4:      #5f87af
*.color12:     #87afd7
! magenta
*.color5:      #875f87
*.color13:     #af87af
! cyan
*.color6:      #5f8787
*.color14:     #87afaf
! white
*.color7:      #bcbcbc
*.color15:     #eeeeee
