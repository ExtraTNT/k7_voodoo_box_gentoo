# i3status — one line, refreshed every 5 s (cheap on a K7).
general {
    output_format = "i3bar"
    colors        = true
    color_good    = "#87875f"
    color_degraded = "#d7a65f"
    color_bad     = "#af5f5f"
    interval      = 5
    separator     = " · "
}

order += "cpu_usage"
order += "memory"
order += "disk /"
order += "ethernet _first_"
order += "volume master"
order += "tztime local"

cpu_usage        { format = "cpu %usage" }
memory           { format = "mem %used"  threshold_degraded = "10%" }
disk "/"         { format = "/ %avail" }
ethernet _first_ { format_up = "%ip"  format_down = "net down" }
volume master    { format = "vol %volume"  format_muted = "vol mute"  device = "default" }
tztime local     { format = "%a %d %b %H:%M" }
