# Layered AFTER s2466.config to test the installer in QEMU on a modern host:
#   KERNEL_FRAGMENT="kernel/s2466.config kernel/qemu-test.config"
# Modern CPUs have no 3DNow!, which a K7 kernel uses for memcpy -> generic i686.
# Not for the real machine.
# CONFIG_MK7 is not set
CONFIG_M686=y
CONFIG_ATA_PIIX=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# QEMU "-vga std" -> KMS for Xorg's modesetting driver (GUI test under WSLg)
CONFIG_DRM_BOCHS=y
