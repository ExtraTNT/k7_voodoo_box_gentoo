# Kernel fragment for the Tyan Tiger MPX S2466
#   AMD-760MPX (762 north / 768 south), 2x Athlon MP, 3 GB, PATA,
#   3Com 3c920, Radeon 9000 Pro (AGP), Voodoo 3 (PCI), SB X-Fi (SB0460)
#
# Applied on top of i386_defconfig with scripts/kconfig/merge_config.sh, then
# `make olddefconfig`.  The build warns about every line here that did not
# survive (lib/system.sh: check_kernel_config).
#
# Everything needed to mount / is built in -> no initramfs -> short boot.

## ── identity ────────────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-s2466"
# CONFIG_LOCALVERSION_AUTO is not set

## ── CPU / SMP / memory ──────────────────────────────────────────────────────
CONFIG_SMP=y
CONFIG_MK7=y
# CONFIG_X86_GENERIC is not set
CONFIG_NR_CPUS=2
CONFIG_X86_MPPARSE=y
CONFIG_HIGHMEM4G=y
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
# CONFIG_EFI is not set
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_KVM is not set

## ── Glide: direct hardware access from user space (runs as root) ────────────
CONFIG_X86_IOPL_IOPERM=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set
# tdfxfb would grab the Voodoo 3 — Glide wants it to itself
# CONFIG_FB_3DFX is not set

## ── Gentoo ──────────────────────────────────────────────────────────────────
CONFIG_GENTOO_LINUX=y
CONFIG_GENTOO_LINUX_UDEV=y
CONFIG_GENTOO_LINUX_PORTAGE=y
CONFIG_GENTOO_LINUX_INIT_SCRIPT=y
# CONFIG_GENTOO_LINUX_INIT_SYSTEMD is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

## ── storage: AMD-768 PATA, built in ─────────────────────────────────────────
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_PATA_AMD=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_IOSCHED_BFQ=y

## ── chipset extras ──────────────────────────────────────────────────────────
# AMD-768 has a hardware RNG: entropy at boot without waiting
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_AMD=y
CONFIG_I2C_AMD756=m

## ── network: 3Com 3c920 = 3c905C family ─────────────────────────────────────
CONFIG_NET_VENDOR_3COM=y
CONFIG_VORTEX=y
# CONFIG_ROOT_NFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_IP_PNP is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set

## ── graphics: Radeon 9000 Pro (RV250) on AMD-762 AGP ────────────────────────
CONFIG_AGP=y
CONFIG_AGP_AMD=y
CONFIG_DRM=y
# module: needs radeon/R200_cp.bin from /lib/firmware (linux-firmware, stage 2)
CONFIG_DRM_RADEON=m
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_DRM_I915 is not set
# CONFIG_FB_RADEON is not set
CONFIG_VGA_CONSOLE=y
CONFIG_FW_LOADER=y
# CONFIG_LOGO is not set

## ── sound: Creative X-Fi (20K1) ─────────────────────────────────────────────
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_CTXFI=y
# CONFIG_SND_HDA_INTEL is not set

## ── USB: onboard AMD-768 OHCI should be DISABLED in the BIOS (hw erratum);
##    these serve a PCI USB 2.0 add-in card.  PS/2 keyboard + mouse:
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
